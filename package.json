{
  "name": "sound-vision",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "node scripts/dev-connected.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5190 --strictPort",
    "test": "node scripts/verify-studio.mjs",
    "test:video": "node --experimental-strip-types --test scripts/test-video-timing.mjs scripts/test-lyric-editing.mjs scripts/test-visualizer-export.mjs scripts/test-visualizer-relay.mjs",
    "test:security": "node --experimental-strip-types --test scripts/test-security.mjs",
    "format": "prettier --write src scripts vite.config.ts",
    "screenshots": "node scripts/capture-studio.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "fflate": "0.8.3",
    "lucide-react": "1.44.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
