# Sound / Vision settings for one install. Copy to sv.env (scripts/install.sh does) and change what differs; anything
# left out uses the default shown. Paths may start with ~.

# ---- basics ----------------------------------------------------------------------------------------------------
# where the app keeps songs, videos, its database and its key (default: data/ next to the code)
# SV_DATA=~/sound-and-vision/data
# where the model files are (ComfyUI's folders under comfyui/, the separation models, Whisper); default: models/
# SV_MODELS=~/sound-and-vision/models
# the built web app (default: web/dist)
# SV_WEB=
# the port the app listens on, on every address of this machine
SV_PORT=7660
# what the interface calls this machine ("Studio", "the music box"); default: its own name (its hostname)
# SV_MACHINE=
# devices on these networks use the app without a key: your home network, e.g. 192.168.1.0/24 (comma-separated).
# Anyone else pairs once with the key in $SV_DATA/secrets/api-token. Leave empty to ask everyone for the key.
SV_OPEN_NETWORKS=
# names you open the app by, besides its IP address, localhost and this machine's own name (comma-separated), e.g.
# studio.lan. A request by any other name is refused, so a web page can't reach the app through a domain of its own.
# SV_HOSTS=

# ---- services on this machine ------------------------------------------------------------------------------------
# sv-comfy (infra/legion/comfy): songs, covers and motion
# SV_COMFY=http://127.0.0.1:8210
# other ComfyUIs to ask to unload their models before a big job (comma-separated); SV_FREE_OTHERS=0 never asks
# SV_OTHER_COMFYS=
# SV_FREE_OTHERS=1
# Ollama, for writing with a local model
# SV_OLLAMA=http://127.0.0.1:11434
# SV_FFMPEG=ffmpeg

# ---- finding a song's words, beat and stems (infra/legion/analysis) ---------------------------------------------
# SV_ANALYSIS_IMAGE=sv-analysis:latest
# SV_ANALYSIS_WORKER=<repo>/infra/legion/analysis/worker
# SV_ANALYSIS_MODELS=$SV_MODELS/audio-separation/sv
# SV_WHISPER=$SV_MODELS/huggingface/models--Systran--faster-whisper-large-v3
# SV_LORAS=$SV_MODELS/comfyui/loras

# ---- writers and directors ---------------------------------------------------------------------------------------
# Claude Code in its studio container (infra/studio); sign in once with: infra/studio/studio.sh signin
# SV_STUDIO_SH=<repo>/infra/studio/studio.sh
# xAI's Grok CLI, if you use Grok
# SV_GROK_BIN=grok
# OpenAI's Codex CLI, for "Sign in with ChatGPT" (npm i -g @openai/codex), and any folders it needs on PATH (its Node)
# SV_CODEX_BIN=codex
# SV_CODEX_PATH=

# ---- the Influence Engine (training your own influences) ---------------------------------------------------------
# your music, where the songs for a training set are looked for first: a folder laid out Artist/…/Song.flac, or a
# network share as smb://host/share/path (read as a guest; needs smbclient). Empty: you add each song's audio by hand.
# SV_MUSIC=
# your own add-ons: a folder of Python files loaded when the app starts (see server/sv/addons.py), for example a
# song finder that gets a training run's songs into your music. Empty: none.
# SV_ADDONS=
# FL YuE2's trainer in its own ComfyUI container
# SV_TRAINER=http://127.0.0.1:8196
# SV_TRAINER_CONTAINER=ai-comfy-fl-yue2
# SV_TRAINER_ROOT=$SV_DATA/trainer
# MOSS-Music, which writes each song's caption: its venv's python, its code and its model (default: beside the venv)
# SV_LISTEN_PYTHON=$SV_DATA/listen/venv/bin/python
# SV_MOSS_CODE=$SV_DATA/listen/MOSS-Music
# SV_MOSS_MODEL=$SV_DATA/listen/models/MOSS-Music-8B-Instruct
# SV_INFLUENCE_TOOLS=<repo>/infra/legion/influence

# ---- VRGameDevGirl's Video Builder (Performance and Hybrid music videos) -----------------------------------------
# SV_VRGDG_BOX=ai-comfy-vrgdg
# SV_VRGDG_URL=http://127.0.0.1:8199
# its films folder as this machine sees it, and as the container does
# SV_VRGDG_FILMS=$SV_DATA/video-builder/output/films
# SV_VRGDG_FILMS_IN=/vrgdg/profile/output/films
# SV_VRGDG_PYTHON=/opt/venv/bin/python
# SV_VRGDG_SKILL=/vrgdg/profile/claude/vrgdg-h3-film
