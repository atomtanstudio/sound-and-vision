# The API token is read only by the local Vite proxy, never by browser JavaScript.
SOUND_VISION_BACKEND_URL=http://127.0.0.1:5191
SOUND_VISION_TOKEN_FILE=.secrets/service.token
# Optional: configure an existing SSH host alias to reach the remote API securely.
SOUND_VISION_SSH_HOST=
SOUND_VISION_SSH_REMOTE_PORT=5191
# Set after the standalone Legion renderer is installed and verified.
# SOUND_VISION_RENDER_BACKEND_URL=http://127.0.0.1:5192
